# ═══════════════════════════════════════════════════════════════════
# Nexus — Environment Configuration (.env.example)
# Copy to .env or run ./start.sh / .\start.ps1 to auto-generate with
# random 32-character secrets.
# ═══════════════════════════════════════════════════════════════════

# Active Docker Compose profile: "synapse" (PostgreSQL + Synapse) or "lite" (Conduwuit + RocksDB)
COMPOSE_PROFILES=synapse

# Domain or IP served by Caddy (e.g. localhost, 192.168.1.50, nexus.local, or chat.example.com)
NEXUS_DOMAIN=localhost

# TLS mode for Caddy: "internal" for self-signed local/LAN certs, or an email address for public ACME
NEXUS_TLS_MODE=internal

# Host LAN IPv4 address advertised by LiveKit for WebRTC UDP/TCP media
HOST_LAN_IP=127.0.0.1

# Matrix server name embedded in user and room IDs (@user:nexus.local)
MATRIX_SERVER_NAME=nexus.local

# Internal Matrix homeserver URL used by Caddy and Token Server
# Use http://synapse:8008 for the default profile or http://conduwuit:8008 for --profile lite
SYNAPSE_URL=http://synapse:8008

# PostgreSQL database credentials (used by the default Synapse profile)
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=
POSTGRES_DB=synapse

# LiveKit SFU API key and secret (shared between LiveKit and Token Server)
LIVEKIT_API_KEY=nexus_key
LIVEKIT_API_SECRET=

# Matrix Synapse cryptographic secrets (32+ random characters each)
REGISTRATION_SHARED_SECRET=
MACAROON_SECRET_KEY=
FORM_SECRET=
